  text: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8M8 13h5"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  star: '<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
  award: '<circle cx="12" cy="8" r="6"/><path d="M15.5 13 17 22l-5-3-5 3 1.5-9"/>',
  dollar: '<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  close: '<path d="M18 6 6 18M6 6l12 12"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  home: '<path d="m3 10 9-7 9 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>',
  // services
  fan: '<circle cx="12" cy="12" r="2"/><path d="M12 10c0-4 1-7 4-7 2 0 2 3-2 7M14 12c4 0 7 1 7 4 0 2-3 2-7-2M12 14c0 4-1 7-4 7-2 0-2-3 2-7M10 12c-4 0-7-1-7-4 0-2 3-2 7 2"/>',
  panel: '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h3M13 6h3M8 10h3M13 10h3M8 14h3M13 14h3M8 18h8"/>',
  meter: '<circle cx="12" cy="12" r="9"/><path d="M12 12l4-4M7 16h10"/>',
  ev: '<rect x="3" y="3" width="11" height="18" rx="2"/><path d="M14 9h3a2 2 0 0 1 2 2v5a1.5 1.5 0 0 0 3 0V8l-3-3"/><path d="m9 7-2 4h3l-2 4"/>',
  generator: '<rect x="2" y="7" width="20" height="12" rx="2"/><path d="M6 19v2M18 19v2M6 7V4h12v3"/><path d="m13 9-3 4h3l-2 4"/>',
  light: '<path d="M4 6h16"/><path d="M7 6a5 5 0 0 0 10 0"/><path d="M12 15v2M7 14l-1.5 1.5M17 14l1.5 1.5M12 20v2"/>',
  outlet: '<rect x="4" y="3" width="16" height="18" rx="3"/><path d="M9 8v3M15 8v3M10 16h4"/>',
  surge: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m13 7-3 5h4l-3 5"/>',
  wire: '<path d="M3 7h5a4 4 0 0 1 4 4v2a4 4 0 0 0 4 4h5"/><circle cx="3" cy="7" r="1"/><circle cx="21" cy="17" r="1"/>',
  smoke: '<circle cx="12" cy="10" r="8"/><circle cx="12" cy="10" r="2"/><path d="M8 21h8"/>',
  outdoor: '<path d="M12 2v6M8 8h8l-1 5H9z"/><path d="M12 13v9M8 22h8"/>',
  spa: '<path d="M2 14h20v4a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3z"/><path d="M7 10c0-2 2-2 2-4M12 10c0-2 2-2 2-4M17 10c0-2 2-2 2-4"/>',
  clipboard: '<rect x="5" y="4" width="14" height="18" rx="2"/><path d="M9 2h6v4H9z"/><path d="m9 13 2 2 4-4"/>',
  tools: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>',
};
const body = paths[name] ?? paths.bolt;
---
<svg class={`icon ${cls}`} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={body} />
