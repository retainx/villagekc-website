---
// items: [{ name, href }]; the last item is the current page.
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((i, n) => (
      <li>{n === items.length - 1 ? <span aria-current="page">{i.name}</span> : <a href={i.href}>{i.name}</a>}</li>
    ))}
  </ol>
</nav>
