---
// variant "navy" for light backgrounds, "white" for dark ones.
import { site } from '../data/site.js';
const { variant = 'navy' } = Astro.props;
---
<a href="/" class="logo" aria-label={`${site.name} home`}>
  <picture>
    <source srcset={`/brand/logo-${variant}.webp`} type="image/webp" />
    <img src={`/brand/logo-${variant}.png`} alt={site.name} width="640" height="264" />
  </picture>
</a>
