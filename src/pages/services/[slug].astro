---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import AreaGrid from '../../components/AreaGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import EstimateSection from '../../components/EstimateSection.astro';
import { site, smsHref, telHref } from '../../data/site.js';
import { services } from '../../data/services.js';
import { areas, placeName } from '../../data/areas.js';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const crumbs = [{ name: 'Services', href: '/services' }, { name: s.name, href: `/services/${s.slug}` }];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    serviceType: s.name,
    description: s.short,
    provider: { '@id': `${site.url}/#business` },
    areaServed: areas.map((a) => ({ '@type': 'City', name: placeName(a) })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title={`${s.name} in Johnson County, KS`}
  description={`${s.short} ${site.name}: licensed in Johnson County, insured, ${site.warranty}. Free estimates.`}
  breadcrumbs={crumbs}
  schema={schema}
>
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>{s.name} in Johnson County, KS</h1>
        <p class="lead">{s.short}</p>
        <div class="cta-row">
          <a href={telHref} class="btn btn-accent btn-lg"><Icon name="phone" /> Call {site.phone.display}</a>
          <a href={smsHref} class="btn btn-light btn-lg"><Icon name="text" /> Text us</a>
          <a href="#estimate" class="btn btn-outline-light btn-lg"><Icon name="mail" /> Message</a>
        </div>
      </div>
      <span class="page-hero-icon" aria-hidden="true"><Icon name={s.icon} size={96} /></span>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <article class="prose">
        <p>{s.intro}</p>

        <h2>What we do</h2>
        <ul class="check-list">{s.includes.map((i) => <li><Icon name="check" size={20} /> {i}</li>)}</ul>

        <h2>Signs it's time to call</h2>
        <ul class="check-list warn">{s.signs.map((i) => <li><Icon name="bolt" size={20} /> {i}</li>)}</ul>

        <h2>Frequently asked questions</h2>
        <div class="faq">
          {s.faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>

        <h2>Areas we serve</h2>
        <p>We provide {s.name.toLowerCase()} throughout Johnson County and the Kansas City area, including:</p>
        <AreaGrid />
      </article>

      <aside class="sidebar">
        <div class="side-card">
          <h3>Free estimate</h3>
          <p>{site.licensed}. Insured. {site.warranty}.</p>
          <a href={telHref} class="btn btn-accent btn-block"><Icon name="phone" /> Call {site.phone.display}</a>
          <a href={smsHref} class="btn btn-primary btn-block"><Icon name="text" /> Text us</a>
          <a href="#estimate" class="btn btn-ghost btn-block"><Icon name="mail" /> Send a message</a>
        </div>
        <div class="side-card side-links">
          <h3>Other services</h3>
          <ul>{services.filter((x) => x.slug !== s.slug).map((x) => <li><a href={`/services/${x.slug}`}>{x.navName}</a></li>)}</ul>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand heading={`Need ${s.navName.toLowerCase()} help?`} />
  <EstimateSection heading={`Get a free ${s.navName.toLowerCase()} estimate`} service={s.slug} />
</Base>
