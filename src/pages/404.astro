---
import Base from '../layouts/Base.astro';
import EstimateSection from '../components/EstimateSection.astro';
---
<Base title="Page Not Found" description="The page you were looking for could not be found.">
  <section class="page-hero">
    <div class="container">
      <h1>Page not found</h1>
      <p class="lead">That page doesn't exist. Try our <a href="/services">services</a> or <a href="/">home page</a>, or reach out below.</p>
    </div>
  </section>
  <EstimateSection />
</Base>
